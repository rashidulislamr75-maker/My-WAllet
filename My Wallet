    <div style="height:12px;"></div>
    <button class="btn-secondary" onclick="document.getElementById('importFileInput').click()" style="display:flex;align-items:center;justify-content:center;gap:8px;"><svg class="ic" style="width:16px;height:16px;" viewBox="0 0 24 24"><path d="M12 21V9"/><path d="M7 14l5-5 5 5"/><path d="M4 19h16"/></svg> Import Data (Upload File)</button>
    <input type="file" id="importFileInput" accept="application/json" style="display:none;" onchange="importDataFile(event)">
  `);
}
function exportData(){
  const data = serializeState();
  const blob = new Blob([JSON.stringify(data, null, 2)], {type:'application/json'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  const dateStr = new Date().toISOString().slice(0,10);
  a.href = url;
  a.download = `my-wallet-backup-${dateStr}.json`;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
  showToast('ব্যাকআপ ফাইল ডাউনলোড হয়েছে');
}
function importDataFile(event){
  const file = event.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = function(e){
    try{
      const data = JSON.parse(e.target.result);
      if(!data || !Array.isArray(data.wallets)) throw new Error('invalid backup file');
      deserializeIntoState(data);
      saveLocal();
      closeModal();
      showToast('ডেটা সফলভাবে ফিরিয়ে আনা হয়েছে');
      renderHome(); renderWallets(); renderProfile(); renderAnalytics();
    }catch(err){
      showToast('ফাইলটি সঠিক নয় বা ক্ষতিগ্রস্ত');
    }
  };
  reader.readAsText(file);
  event.target.value = '';
}
function importOnSetup(event){
  const file = event.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = function(e){
    try{
      const data = JSON.parse(e.target.result);
      if(!data || !Array.isArray(data.wallets) || !data.pin) throw new Error('invalid backup file');
      deserializeIntoState(data);
      saveLocal();
      showToast('ব্যাকআপ থেকে ডেটা ফিরিয়ে আনা হয়েছে');
      finishAuth();
    }catch(err){
      showToast('ফাইলটি সঠিক নয় বা ক্ষতিগ্রস্ত');
    }
  };
  reader.readAsText(file);
  event.target.value = '';
}

