/* ---------------- TREND / SPARKLINE ---------------- */
function buildPolylinePoints(values, width, height, padTop, padBottom){
  if(!values.length) return `0,${height/2} ${width},${height/2}`;
  if(values.length===1) return `0,${height/2} ${width},${height/2}`;
  const min = Math.min(...values), max = Math.max(...values);
  const range = (max-min) || 1;
  const usableH = height - padTop - padBottom;
  const stepX = width/(values.length-1);
  return values.map((v,i)=>{
    const x = i*stepX;
    const y = padTop + usableH - ((v-min)/range)*usableH;
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  }).join(' ');
}
function cumulativeSeries(txList){
  const sorted = [...txList].sort((a,b)=>a.dt-b.dt);
  let running = 0;
  const values = [0];
  sorted.forEach(t=>{
    running += (txSign(t)==='-') ? -t.amount : t.amount;
    values.push(running);
  });
  return values;
}
function renderSparkline(currentNetWorth){
  const values = cumulativeSeries(state.transactions);
  const points = buildPolylinePoints(values, 300, 40, 4, 4);
  document.getElementById('sparkLine').setAttribute('points', points);

  const pill = document.getElementById('netWorthPill');
  if(state.transactions.length < 2){
    pill.style.display = 'none';
  } else {
    const first = values[0], last = values[values.length-1];
    const diff = last - first;
    const base = Math.abs(first) > 0 ? Math.abs(first) : Math.max(1, Math.abs(last));
    const pct = (diff/base*100);
    pill.style.display = 'inline-block';
    if(diff >= 0){
      pill.className = 'pill-up';
      pill.textContent = '↑ +' + Math.abs(pct).toFixed(1) + '%';
    } else {
      pill.className = 'pill-down';
      pill.textContent = '↓ -' + Math.abs(pct).toFixed(1) + '%';
    }
  }
}

/* ---------------- CALENDAR ---------------- */
let calYear, calMonth;
function openCalendar(){
  const now = new Date();
  calYear = now.getFullYear();
  calMonth = now.getMonth();
  showScreen('calendar');
}
function changeCalMonth(delta){
  calMonth += delta;
  if(calMonth<0){ calMonth=11; calYear--; }
  if(calMonth>11){ calMonth=0; calYear++; }
  renderCalendar();
}
function netWorthAsOf(endDate){
  let running = 0;
  state.transactions.forEach(t=>{
    if(t.dt <= endDate) running += (txSign(t)==='-') ? -t.amount : t.amount;
  });
  return running;
}
function renderCalendar(){
  const monthNames = ["January","February","March","April","May","June","July","August","September","October","November","December"];
  document.getElementById('calTitle').textContent = monthNames[calMonth] + ' ' + calYear;

  const firstDay = new Date(calYear, calMonth, 1);
  const daysInMonth = new Date(calYear, calMonth+1, 0).getDate();
  const startOffset = firstDay.getDay();
  const today = new Date();

  let cells = '';
  for(let i=0;i<startOffset;i++) cells += `<div class="cal-cell empty"></div>`;
  for(let d=1; d<=daysInMonth; d++){
    const dayStart = new Date(calYear, calMonth, d, 0,0,0);
    const dayEnd = new Date(calYear, calMonth, d, 23,59,59);
    const dayTx = state.transactions.filter(t=>t.dt>=dayStart && t.dt<=dayEnd);
    const exp = dayTx.filter(t=>t.type==='expense').reduce((a,b)=>a+b.amount,0);
    const inc = dayTx.filter(t=>t.type==='income').reduce((a,b)=>a+b.amount,0);
    const isToday = today.getFullYear()===calYear && today.getMonth()===calMonth && today.getDate()===d;
    cells += `<div class="cal-cell ${isToday?'today':''}" onclick="openDayModal(${calYear},${calMonth},${d})">
      <div class="dnum">${d}</div>
      ${exp>0?`<div class="dexp">-${Math.round(exp)>=1000?(Math.round(exp/1000))+'k':Math.round(exp)}</div>`:''}
      ${inc>0?`<div class="dinc">+${Math.round(inc)>=1000?(Math.round(inc/1000))+'k':Math.round(inc)}</div>`:''}
    </div>`;
  }
  document.getElementById('calGrid').innerHTML = cells;

  const values = [];
  for(let d=1; d<=daysInMonth; d++){
    values.push(netWorthAsOf(new Date(calYear, calMonth, d, 23,59,59)));
  }
  const points = buildPolylinePoints(values, 300, 90, 8, 8);
  document.getElementById('calTrendLine').setAttribute('points', points);
}
function openDayModal(y,m,d){
  const dayStart = new Date(y,m,d,0,0,0);
  const dayEnd = new Date(y,m,d,23,59,59);
  const dayTx = state.transactions.filter(t=>t.dt>=dayStart && t.dt<=dayEnd).sort((a,b)=>b.dt-a.dt);
  const exp = dayTx.filter(t=>t.type==='expense').reduce((a,b)=>a+b.amount,0);
  const inc = dayTx.filter(t=>t.type==='income').reduce((a,b)=>a+b.amount,0);
  const dateLbl = dayStart.toLocaleDateString('en-US',{weekday:'long', day:'numeric', month:'long', year:'numeric'});
  openModal(`
    <div class="modal-head"><h3>${dateLbl}</h3><div class="modal-close" onclick="closeModal()"><svg class="ic" style="width:14px;height:14px;" viewBox="0 0 24 24"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg></div></div>
    <div class="two-col" style="margin-bottom:14px;">
      <div class="stat-box"><div class="stitle"><span class="dot" style="background:var(--red)"></span> EXPENSE</div><div class="samt">${fmt(exp)}</div></div>
      <div class="stat-box"><div class="stitle"><span class="dot" style="background:var(--green)"></span> INCOME</div><div class="samt">${fmt(inc)}</div></div>
    </div>
    <div class="tx-list">${dayTx.length ? dayTx.map(txRowHtml).join('') : '<div class="empty-note">No transactions on this day.</div>'}</div>
  `);
}

