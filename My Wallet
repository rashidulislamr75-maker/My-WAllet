<script>
/* ============================================================
   এই অ্যাপটি সম্পূর্ণ অফলাইন — কোনো ইন্টারনেট বা সার্ভারের প্রয়োজন নেই।
   সব ডেটা এই ডিভাইসের localStorage-এ সংরক্ষিত থাকে।
   ============================================================ */
/* ---------------- HARD ZOOM LOCK (belt-and-braces for WebView wrappers
   like AppsGeyser that sometimes ignore the viewport meta tag) ---------------- */
(function lockZoom(){
  // Block pinch-zoom gestures (iOS WebKit-style gesture events, harmless elsewhere)
  document.addEventListener('gesturestart', function(e){ e.preventDefault(); }, {passive:false});
  document.addEventListener('gesturechange', function(e){ e.preventDefault(); }, {passive:false});
  // Block multi-touch pinch on Android WebViews
  document.addEventListener('touchmove', function(e){
    if(e.touches && e.touches.length > 1) e.preventDefault();
  }, {passive:false});
  // Block double-tap-to-zoom
  let lastTouchEnd = 0;
  document.addEventListener('touchend', function(e){
    const now = Date.now();
    if(now - lastTouchEnd <= 300) e.preventDefault();
    lastTouchEnd = now;
  }, {passive:false});
})();

const LS_KEY = 'mywallet_appdata_v1';

/* ---------------- STATE ---------------- */
let state = {
  user: { name:"" },
  pin: null,
  wallets: [
    {id:"bkash", name:"bKash", color:"#e2136e", balance:0, custom:false},
    {id:"nagad", name:"Nagad", color:"#f7941e", balance:0, custom:false},
    {id:"rocket", name:"Rocket", color:"#8a3ffc", balance:0, custom:false},
    {id:"binance", name:"Binance", color:"#f0b90b", balance:0, custom:false},
    {id:"bank", name:"Bank Account", color:"#60a5fa", balance:0, custom:false},
    {id:"cash", name:"Cash", color:"#22c55e", balance:0, custom:false},
  ],
  transactions: [],
  theme: "dark"
};

const THEMES = [
  {id:'light', name:'Light', desc:'উজ্জ্বল, সাদা ব্যাকগ্রাউন্ড', bg:'#f4f5f8', panel:'#ffffff'},
  {id:'grey',  name:'Grey',  desc:'নরম, মাঝারি টোনের ব্যাকগ্রাউন্ড', bg:'#3d4149', panel:'#484c55'},
  {id:'dark',  name:'Dark',  desc:'কালো, চোখে আরামদায়ক ব্যাকগ্রাউন্ড', bg:'#0b0e14', panel:'#131722'},
];

function cryptoId(){ return 'tx_'+Math.random().toString(36).slice(2,10); }
function fmt(n){ return "Tk " + Math.round(n).toLocaleString('en-IN'); }
function walletById(id){ return state.wallets.find(w=>w.id===id); }

/* ---------------- NAVIGATION ---------------- */
function showScreen(id){
  // Blur any focused input first so the on-screen keyboard collapses BEFORE
  // we swap screens — Android WebView (AppsGeyser etc.) sometimes leaves the
  // page's viewport/scroll position shifted if the keyboard is still closing
  // while the layout changes underneath it (this is what caused the Home
  // screen to look cut-off/shifted right after PIN entry).
  if(document.activeElement && typeof document.activeElement.blur === 'function'){
    document.activeElement.blur();
  }

  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  const nextScreen = document.getElementById(id);
  nextScreen.classList.add('active');
  const nav = document.getElementById('bottomnav');
  const indicator = document.getElementById('homeIndicator');
  if(id === 'login'){
    nav.style.display='none'; indicator.style.display='none';
  } else {
    nav.style.display='flex'; indicator.style.display='block';
    document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));
    const target = document.querySelector('.nav-item[data-target="'+id+'"]');
    if(target) target.classList.add('active');
  }
  if(id==='home') renderHome();
  if(id==='wallets') renderWallets();
  if(id==='profile') renderProfile();
  if(id==='analytics') renderAnalytics();
  if(id==='calendar') renderCalendar();
  closeNotifications();

  // Force the scroll/viewport position back to a clean top-left state.
  // Run it now and again after the keyboard-close animation settles.
  resetScrollPosition(nextScreen);
  setTimeout(()=>resetScrollPosition(nextScreen), 350);
}

function resetScrollPosition(screenEl){
  window.scrollTo(0,0);
  document.documentElement.scrollLeft = 0;
  document.body.scrollLeft = 0;
  if(screenEl){
    screenEl.scrollLeft = 0;
    screenEl.scrollTop = 0;
  }
}

/* ---------------- TOAST ---------------- */
let toastTimer;
function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(()=>t.classList.remove('show'), 2200);
}

/* ---------------- MODAL ---------------- */
function openModal(html){
  document.getElementById('modalBody').innerHTML = html;
  document.getElementById('overlay').classList.add('open');
}
function closeModal(){ document.getElementById('overlay').classList.remove('open'); }

/* ---------------- LOCAL STORAGE (fully offline persistence) ---------------- */
function serializeState(){
  return {
    user: state.user,
    pin: state.pin,
    wallets: state.wallets,
    theme: state.theme,
    transactions: state.transactions.map(t=>({...t, dt: t.dt.toISOString()})),
    updatedAt: new Date().toISOString()
  };
}
function deserializeIntoState(data){
  state.user = data.user || state.user;
  state.pin = data.pin || state.pin;
  state.wallets = data.wallets || state.wallets;
  state.theme = data.theme || 'dark';
  state.transactions = (data.transactions || []).map(t=>({...t, dt:new Date(t.dt)}));
  document.documentElement.setAttribute('data-theme', state.theme);
}
function saveLocal(){
  try{
    localStorage.setItem(LS_KEY, JSON.stringify(serializeState()));
  }catch(err){
    console.error('Local save failed:', err);
  }
}
function loadLocalRaw(){
  try{
    const raw = localStorage.getItem(LS_KEY);
    return raw ? JSON.parse(raw) : null;
  }catch(err){
    console.error('Local load failed:', err);
    return null;
  }
}
// Kept under its original name so every existing call site (add/delete tx,
// wallet changes, theme changes, profile edits, etc.) keeps working unchanged —
// it now just persists to this device instead of the cloud.
function syncStateToCloud(){ saveLocal(); }

/* ---------------- PIN AUTH (fully offline, native keyboard entry) ---------------- */
let pinState = { mode:null, firstEntry:null };

function initAuthScreen(){
  const data = loadLocalRaw();
  if(data && data.pin){
    document.getElementById('pinSetupCard').style.display='none';
    document.getElementById('pinUnlockCard').style.display='block';
    document.getElementById('unlockGreeting').textContent = data.user && data.user.name ? ('Welcome back, ' + data.user.name) : 'Welcome Back';
    pinState = {mode:'unlock', firstEntry:null};
    const inp = document.getElementById('unlockPinInput');
    inp.value = '';
    setTimeout(()=>inp.focus(), 250);
  } else {
    document.getElementById('pinSetupCard').style.display='block';
    document.getElementById('pinUnlockCard').style.display='none';
    document.getElementById('setupTitle').textContent = 'Create Your PIN';
    document.getElementById('setupPinLabel').textContent = '৪-সংখ্যার পিন দিন';
    document.getElementById('setupPinInput').value = '';
    pinState = {mode:'setup-first', firstEntry:null};
  }
}

// Called on every keystroke from the phone's own keyboard — strips non-digits,
// caps at 4, and auto-submits once 4 digits are in.
function onSetupPinInput(el){
  el.value = el.value.replace(/[^0-9]/g,'').slice(0,4);
  if(el.value.length===4) handlePinComplete(el.value);
}
function onUnlockPinInput(el){
  el.value = el.value.replace(/[^0-9]/g,'').slice(0,4);
  if(el.value.length===4) handlePinComplete(el.value);
}

function handlePinComplete(pinValue){
  if(pinState.mode==='setup-first'){
    const name = document.getElementById('setupName').value.trim();
    if(!name){
      showToast('আগে আপনার নাম লিখুন');
      document.getElementById('setupPinInput').value='';
      return;
    }
    pinState.firstEntry = pinValue;
    pinState.mode='setup-confirm';
    document.getElementById('setupTitle').textContent = 'Confirm Your PIN';
    document.getElementById('setupPinLabel').textContent = 'আবার সেই পিনটি দিন';
    const inp = document.getElementById('setupPinInput');
    inp.value='';
    inp.focus();
  } else if(pinState.mode==='setup-confirm'){
    if(pinValue !== pinState.firstEntry){
      showToast('পিন মিলছে না, আবার চেষ্টা করুন');
      pinState.firstEntry=null; pinState.mode='setup-first';
      document.getElementById('setupTitle').textContent = 'Create Your PIN';
      document.getElementById('setupPinLabel').textContent = '৪-সংখ্যার পিন দিন';
      const inp = document.getElementById('setupPinInput');
      inp.value='';
      inp.focus();
      return;
    }
    const name = document.getElementById('setupName').value.trim();
    state.user.name = name;
    state.pin = pinValue;
    saveLocal();
    finishAuth();
  } else if(pinState.mode==='unlock'){
    const data = loadLocalRaw();
    if(data && pinValue === data.pin){
      deserializeIntoState(data);
      finishAuth();
    } else {
      showToast('ভুল পিন, আবার চেষ্টা করুন');
      const inp = document.getElementById('unlockPinInput');
      inp.value='';
      inp.focus();
    }
  }
}

function finishAuth(){
  const now = new Date();
  document.getElementById('txDate').value = now.toISOString().slice(0,10);
  document.getElementById('txTime').value = now.toTimeString().slice(0,5);
  showScreen('home');
}

