    <div class="textbox"><input class="plain" id="adjBalInput" type="number" value="${w.balance}"></div>
    <button class="btn-primary" onclick="saveAdjustBalance('${id}')">Save Balance</button>
  `);
}
function saveAdjustBalance(id){
  const w = walletById(id);
  const val = parseFloat(document.getElementById('adjBalInput').value);
  if(isNaN(val)){ showToast('Enter a valid number'); return; }
  const delta = val - w.balance;
  if(delta !== 0){
    state.transactions.unshift({
      id: cryptoId(), type:'adjustment', subcat:'', wallet:id,
      amount: Math.abs(delta), sign: delta>=0 ? '+' : '-',
      dt: new Date(), note:'Balance Adjustment', desc:''
    });
  }
  w.balance = val;
  closeModal(); showToast('Balance updated'); renderHome(); renderWallets(); renderAnalytics();
  syncStateToCloud();
}
function deleteWallet(id){
  state.wallets = state.wallets.filter(w=>w.id!==id);
  walletFilterIdx = -1;
  const walletChipEl = document.getElementById('walletChip');
  if(walletChipEl) walletChipEl.textContent = 'All Wallets';
  closeModal(); showToast('Wallet deleted'); renderHome(); renderWallets(); renderAnalytics();
  syncStateToCloud();
}

/* ---------------- TX DETAIL MODAL ---------------- */
function openTxModal(id){
  const t = state.transactions.find(x=>x.id===id);
  const w = walletById(t.wallet);
  openModal(`
    <div class="modal-head"><h3>${t.note || t.type}</h3><div class="modal-close" onclick="closeModal()"><svg class="ic" style="width:14px;height:14px;" viewBox="0 0 24 24"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg></div></div>
    <div style="font-size:24px;font-weight:700;margin-bottom:4px;" class="${txClass(t)}">${txSign(t)}${fmt(t.amount)}</div>
