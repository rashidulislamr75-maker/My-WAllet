<!DOCTYPE html>
<html lang="bn" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="format-detection" content="telephone=no,email=no,address=no">
<meta name="mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#0b0e14">
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%233b82f6'/%3E%3Cpath d='M14 22a6 6 0 0 1 6-6h24a4 4 0 0 1 4 4v4H20a2 2 0 1 0 0 4h28v14a6 6 0 0 1-6 6H20a6 6 0 0 1-6-6V22z' fill='white'/%3E%3Ccircle cx='40' cy='34' r='3.4' fill='%233b82f6'/%3E%3C/svg%3E">
<title>My Wallet</title>
<style>
  :root, html[data-theme="dark"]{
    --bg:#0b0e14; --panel:#131722; --panel2:#171c29; --border:#232838;
    --text:#eef1f7; --sub:#8891a7; --blue:#3b82f6; --blue-dark:#2563eb;
    --green:#22c55e; --red:#ef4444; --yellow:#f59e0b; --binance:#f0b90b;
    --outer-bg:#05060a; --native-scheme:dark;
    --radius:18px;
  }
  html[data-theme="light"]{
    --bg:#f4f5f8; --panel:#ffffff; --panel2:#eef0f4; --border:#dfe2e8;
    --text:#12151c; --sub:#6b7280; --blue:#3b82f6; --blue-dark:#2563eb;
    --green:#16a34a; --red:#dc2626; --yellow:#d97706; --binance:#b8860b;
    --outer-bg:#e7e9ee; --native-scheme:light;
  }
  html[data-theme="grey"]{
    --bg:#3d4149; --panel:#484c55; --panel2:#52565f; --border:#5f636c;
    --text:#f2f3f5; --sub:#c7cad0; --blue:#5b9bf7; --blue-dark:#3b82f6;
    --green:#4ade80; --red:#f87171; --yellow:#fbbf24; --binance:#f0b90b;
    --outer-bg:#2a2d33; --native-scheme:dark;
  }
  *{box-sizing:border-box; margin:0; padding:0; -webkit-tap-highlight-color:transparent; max-width:100%;}
  svg.ic{width:18px; height:18px; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; flex-shrink:0; vertical-align:middle;}
  html{width:100%; overflow-x:hidden; -webkit-text-size-adjust:100%; text-size-adjust:100%; touch-action:pan-y; overscroll-behavior:none;}
  body{width:100%; overflow-x:hidden; touch-action:pan-y; overscroll-behavior:none;}
  input, select, textarea, button{font-size:16px; -webkit-user-select:auto;}
  img, svg{max-width:100%; height:auto; display:block;}
  body{background:var(--outer-bg); font-family:'Segoe UI', Roboto, -apple-system, sans-serif; color:var(--text); display:flex; justify-content:center; padding:0; min-height:100vh; transition:background .2s ease; -webkit-user-select:none; user-select:none;}
  .phone{
    width:100%;
    max-width:100%;
    background:var(--bg);
    overflow-x:hidden;
    position:relative;
    min-height:100vh;
  }
  @media (min-width:520px){
    body{padding:24px 8px;}
    .phone{
      width:390px;
      max-width:100%;
      min-height:auto;
      border-radius:36px;
      border:8px solid #14161c;
      box-shadow:0 30px 60px rgba(0,0,0,.5);
    }
    .screen{min-height:680px; max-height:760px;}
  }
  .statusbar{display:none;}
  .screen{display:none; min-height:calc(100vh - 34px); max-height:calc(100vh - 34px); overflow-y:auto; overflow-x:hidden; padding:env(safe-area-inset-top,14px) 20px 90px; position:relative; width:100%;}
  .screen.active{display:block; animation:fadeIn .2s ease;}
  @keyframes fadeIn{from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:translateY(0);}}
  .screen::-webkit-scrollbar{width:0;}

  /* LOGIN */
  #login .brand{text-align:center; margin-top:24px;}
  .logo-badge{width:56px; height:56px; border-radius:16px; background:linear-gradient(135deg,var(--blue),#60a5fa); display:flex; align-items:center; justify-content:center; margin:0 auto 14px; font-size:26px;}
  #login h1{font-size:22px; margin-bottom:4px;}
  #login .tag{color:var(--sub); font-size:13px; margin-bottom:28px;}
  .card{background:var(--panel); border:1px solid var(--border); border-radius:var(--radius); padding:20px;}
  .card h2{font-size:18px; margin-bottom:18px; text-align:center;}
  .field{margin-bottom:14px;}
  .field label{font-size:11px; color:var(--sub); letter-spacing:.05em; display:block; margin-bottom:6px;}
  .field .input{background:var(--panel2); border:1px solid var(--border); border-radius:12px; padding:12px 14px; font-size:14px; display:flex; align-items:center; gap:8px;}
  .field .input input{background:transparent; border:none; outline:none; color:var(--text); font-size:16px; width:100%; font-family:inherit;}
  .forgot{text-align:center; font-size:12px; color:var(--blue); margin-top:18px; cursor:pointer;}
  .btn-primary{width:100%; background:linear-gradient(135deg,var(--blue),var(--blue-dark)); color:#fff; border:none; border-radius:12px; padding:14px; font-size:15px; font-weight:600; cursor:pointer;}
  .btn-secondary{width:100%; background:var(--panel2); color:var(--text); border:1px solid var(--border); border-radius:12px; padding:13px; font-size:14px; font-weight:600; cursor:pointer;}
  .btn-danger{width:100%; background:rgba(239,68,68,.12); color:var(--red); border:1px solid rgba(239,68,68,.35); border-radius:12px; padding:13px; font-size:14px; font-weight:600; cursor:pointer;}

  /* PIN */
  .pin-input{background:var(--panel2); border:1px solid var(--border); border-radius:12px; padding:14px; font-size:22px; font-weight:700; letter-spacing:10px; text-align:center; color:var(--text); width:100%; outline:none; font-family:inherit;}
  .pin-input:focus{border-color:var(--blue);}

  /* HOME */
  .topbar{display:flex; justify-content:space-between; align-items:center; padding-top:18px; position:relative;}
  .welcome-row{display:flex; align-items:center; gap:10px; cursor:pointer;}
  .avatar{width:40px; height:40px; border-radius:50%; background:linear-gradient(135deg,#f472b6,#a855f7); display:flex; align-items:center; justify-content:center; font-weight:700; font-size:14px;}
  .welcome-text{font-size:11px; color:var(--sub);}
  .welcome-text b{display:block; font-size:14px; color:var(--text); font-weight:600;}
  .bell{width:38px; height:38px; border-radius:50%; background:var(--panel2); display:flex; align-items:center; justify-content:center; border:1px solid var(--border); cursor:pointer; position:relative;}
  .bell .badge{position:absolute; top:-2px; right:-2px; width:9px; height:9px; border-radius:50%; background:var(--red); border:2px solid var(--bg);}
  .notif-panel{position:absolute; top:48px; right:0; width:270px; max-width:78vw; background:var(--panel); border:1px solid var(--border); border-radius:14px; padding:10px; z-index:40; display:none; box-shadow:0 12px 30px rgba(0,0,0,.5);}
  .notif-panel.open{display:block;}
  .notif-item{padding:9px 8px; font-size:12px; border-bottom:1px solid var(--border); color:var(--sub);}
  .notif-item:last-child{border-bottom:none;}
  .notif-item b{color:var(--text);}

  .networth{margin-top:16px; background:linear-gradient(160deg,#141a2a,#0e1220); border:1px solid var(--border); border-radius:var(--radius); padding:18px;}
  .networth-head{display:flex; justify-content:space-between; align-items:flex-start; gap:10px;}
  .calendar-btn{width:34px; height:34px; border-radius:10px; background:var(--panel2); border:1px solid var(--border); display:flex; align-items:center; justify-content:center; cursor:pointer; font-size:15px; flex-shrink:0;}
  .networth .lbl{font-size:11px; color:var(--sub); letter-spacing:.05em;}
  .networth .amt{font-size:28px; font-weight:700; margin:6px 0 2px; display:flex; align-items:center; gap:8px;}
  .pill-up{background:rgba(34,197,94,.15); color:var(--green); font-size:11px; padding:3px 8px; border-radius:20px; font-weight:600;}
  .pill-down{background:rgba(239,68,68,.15); color:var(--red); font-size:11px; padding:3px 8px; border-radius:20px; font-weight:600;}
  .spark{height:38px; margin-top:6px;}

  .section-title{display:flex; justify-content:space-between; align-items:center; margin:20px 0 10px;}
  .section-title h3{font-size:14px; font-weight:600;}
  .section-title a{font-size:12px; color:var(--blue); cursor:pointer;}

  /* WALLET SCROLL ROW — FIX: added a clipping wrapper + CSS containment so
     Android WebView (AppsGeyser-style APK wrappers) can't measure this row's
     unclipped intrinsic width when computing the page's "ideal" viewport
     scale. This was the root cause of the Home-page-only zoom/crop bug. */
  .wallets-scroll-clip{
    width:100%;
    max-width:100%;
    overflow:hidden;
    contain:layout style paint;
  }
  .wallets-scroll{
    display:flex; gap:10px; overflow-x:auto; padding-bottom:4px;
    contain:layout style paint;
    width:100%; max-width:100%;
    overscroll-behavior-x:contain;
    touch-action:pan-x;
  }
  .wallets-scroll::-webkit-scrollbar{display:none;}
  .wallet-chip{min-width:104px; background:var(--panel); border:1px solid var(--border); border-radius:14px; padding:12px; flex-shrink:0; cursor:pointer; transition:border-color .15s;}
  .wallet-chip:active{border-color:var(--blue);}
  .wallet-chip .wname{display:flex; align-items:center; gap:6px; font-size:12px; color:var(--sub); margin-bottom:8px;}
  .dot{width:6px; height:6px; border-radius:50%; flex-shrink:0;}
  .wallet-chip .wamt{font-size:15px; font-weight:700;}

  .stat-grid{display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:12px;}
  .stat-box{background:var(--panel); border:1px solid var(--border); border-radius:14px; padding:12px;}
  .stat-box .stitle{display:flex; align-items:center; gap:6px; font-size:11px; color:var(--sub); margin-bottom:6px;}
  .stat-box .samt{font-size:15px; font-weight:700;}

  .tx-list{margin-top:6px;}
  .tx-row{display:flex; align-items:center; gap:12px; padding:12px 0; border-bottom:1px solid var(--border); cursor:pointer;}
  .tx-row:last-child{border-bottom:none;}
  .tx-icon{width:38px; height:38px; border-radius:12px; background:var(--panel2); display:flex; align-items:center; justify-content:center; font-size:16px; flex-shrink:0;}
  .tx-info{flex:1; min-width:0;}
  .tx-info .tname{font-size:13.5px; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
  .tx-info .tmeta{font-size:11px; color:var(--sub);}
  .tx-amt{font-size:13.5px; font-weight:700; flex-shrink:0;}
  .tx-amt.neg{color:var(--red);}
  .tx-amt.pos{color:var(--green);}
  .empty-note{text-align:center; color:var(--sub); font-size:12.5px; padding:30px 0;}

  .add-tx-btn{grid-column:1/3; background:linear-gradient(135deg,var(--blue),var(--blue-dark)); border:none; border-radius:14px; padding:14px; display:flex; align-items:center; justify-content:center; gap:8px; color:#fff; font-size:14px; font-weight:700; cursor:pointer; box-shadow:0 8px 20px rgba(59,130,246,.35);}
  .add-tx-btn:active{opacity:.9;}
  .add-tx-btn .plus-ic{font-size:19px; line-height:1;}

  /* ADD TRANSACTION */
  .addtx-head{display:flex; justify-content:space-between; align-items:center; padding-top:20px; margin-bottom:20px;}
  .addtx-head h2{font-size:20px;}
  .gear{width:36px; height:36px; border-radius:50%; background:var(--panel2); border:1px solid var(--border); display:flex; align-items:center; justify-content:center; cursor:pointer; font-size:16px;}
  .label-sm{font-size:11px; color:var(--sub); letter-spacing:.05em; margin-bottom:8px; display:block;}
  .chip-row{display:flex; flex-wrap:wrap; gap:8px; margin-bottom:18px;}
  .chip{padding:9px 16px; border-radius:20px; font-size:13px; background:var(--panel2); border:1px solid var(--border); color:var(--sub); cursor:pointer;}
  .chip.active{background:var(--blue); color:#fff; border-color:var(--blue);}
  .wallet-select-row{display:flex; flex-wrap:wrap; gap:8px; margin-bottom:18px;}
  .wsel{padding:10px 14px; border-radius:12px; font-size:13px; background:var(--panel2); border:1px solid var(--border); color:var(--sub); cursor:pointer; display:flex; align-items:center; gap:6px;}
  .wsel.active{background:var(--panel); border-color:var(--blue); color:var(--text);}
  select.plainselect{background:var(--panel); border:1px solid var(--border); color:var(--text); border-radius:12px; padding:11px 12px; font-size:16px; width:100%; margin-bottom:18px; font-family:inherit;}

  .amount-box{background:var(--panel); border:1px solid var(--border); border-radius:16px; padding:18px; margin-bottom:16px;}
  .amount-box .label-sm{margin-bottom:10px;}
  .amtval{font-size:30px; font-weight:700; display:flex; justify-content:space-between; align-items:center;}
  .amtval .curr{display:flex; align-items:center;}
  .amount-input{background:transparent; border:none; color:var(--text); font-size:30px; font-weight:700; width:100%; max-width:180px; outline:none; font-family:inherit;}
  .bksp{cursor:pointer; font-size:18px; color:var(--sub); padding:4px 8px;}

  .two-col{display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:16px;}
  .input-box{background:var(--panel); border:1px solid var(--border); border-radius:14px; padding:10px 14px; font-size:13px; display:flex; align-items:center; gap:8px; min-width:0;}
  .input-box input{background:transparent; border:none; color:var(--text); font-size:16px; outline:none; width:100%; min-width:0; font-family:inherit; color-scheme:var(--native-scheme);}
  .textbox{background:var(--panel); border:1px solid var(--border); border-radius:14px; padding:12px 14px; font-size:13.5px; margin-bottom:16px;}
  textarea.plain, input.plain{background:transparent; border:none; color:var(--text); font-size:16px; width:100%; outline:none; font-family:inherit; resize:none;}
  .note-box textarea{min-height:56px;}

  /* ANALYTICS */
  .an-tabs{display:flex; gap:8px; background:var(--panel2); border-radius:12px; padding:4px; margin-top:18px;}
  .an-tab{flex:1; text-align:center; padding:9px; border-radius:9px; font-size:13px; color:var(--sub); cursor:pointer;}
  .an-tab.active{background:var(--blue); color:#fff; font-weight:600;}
  .filter-row{display:flex; gap:8px; margin:14px 0; flex-wrap:wrap;}
  .filter-chip{padding:7px 12px; border-radius:10px; background:var(--panel2); border:1px solid var(--border); font-size:12px; color:var(--sub); cursor:pointer;}
  .filter-chip.active{background:var(--panel); color:var(--text); border-color:var(--blue);}
  select.filter-select{background:var(--panel2); border:1px solid var(--border); border-radius:10px; padding:7px 10px; font-size:16px; color:var(--sub); font-family:inherit; max-width:100%;}

  .donut-wrap{display:flex; align-items:center; gap:16px; background:var(--panel); border:1px solid var(--border); border-radius:var(--radius); padding:16px; margin-top:6px;}
  .legend{font-size:12px;}
  .legend-item{display:flex; align-items:center; gap:6px; margin-bottom:8px; color:var(--sub);}

  .bars-card{background:var(--panel); border:1px solid var(--border); border-radius:var(--radius); padding:16px; margin-top:14px;}
  .bars-title{font-size:11px; color:var(--sub); letter-spacing:.05em; margin-bottom:14px;}
  .bars{display:flex; align-items:flex-end; gap:10px; height:90px;}
  .bar-group{display:flex; flex-direction:column; align-items:center; gap:3px; flex:1;}
  .bar-pair{display:flex; gap:3px; align-items:flex-end; height:70px;}
  .bar{width:7px; border-radius:3px 3px 0 0;}
  .bar.in{background:var(--green);}
  .bar.ex{background:var(--red);}
  .bar-group .m{font-size:9px; color:var(--sub);}

  .cat-list{margin-top:14px;}
  .cat-row{display:flex; align-items:center; gap:10px; padding:10px 0; border-bottom:1px solid var(--border);}
  .cat-row:last-child{border-bottom:none;}
  .cat-row .cname{flex:1; font-size:13px;}
  .cat-row .camt{font-size:13px; font-weight:600;}

  .hist-row{display:flex; align-items:center; gap:10px; padding:11px 0; border-bottom:1px solid var(--border);}
  .hist-row .xdel{color:var(--sub); cursor:pointer; padding:4px; display:flex; align-items:center;}

  /* CALENDAR SCREEN */
  .cal-head{display:flex; align-items:center; justify-content:space-between; padding-top:20px; margin-bottom:18px;}
  .cal-back{width:34px; height:34px; border-radius:50%; background:var(--panel2); border:1px solid var(--border); display:flex; align-items:center; justify-content:center; cursor:pointer; font-size:15px; flex-shrink:0;}
  .cal-month-nav{display:flex; align-items:center; gap:12px;}
  .cal-month-nav button{background:var(--panel2); border:1px solid var(--border); color:var(--text); width:28px; height:28px; border-radius:8px; cursor:pointer; font-size:13px; display:flex; align-items:center; justify-content:center;}
  .cal-title{font-size:14.5px; font-weight:600; min-width:110px; text-align:center;}
  .cal-weekdays{display:grid; grid-template-columns:repeat(7,1fr); text-align:center; font-size:10px; color:var(--sub); margin-bottom:8px;}
  .cal-grid{display:grid; grid-template-columns:repeat(7,1fr); gap:5px;}
  .cal-cell{aspect-ratio:1; border-radius:10px; background:var(--panel); border:1px solid var(--border); display:flex; flex-direction:column; align-items:center; justify-content:center; font-size:11.5px; cursor:pointer; gap:1px; padding:2px;}
  .cal-cell.empty{background:transparent; border:none; cursor:default;}
  .cal-cell.today{border-color:var(--blue); border-width:1.5px;}
  .cal-cell .dnum{font-weight:600;}
  .cal-cell .dexp{font-size:8px; color:var(--red); font-weight:600;}
  .cal-cell .dinc{font-size:8px; color:var(--green); font-weight:600;}
  .cal-legend{display:flex; gap:16px; margin-top:12px; font-size:11px; color:var(--sub);}
  .cal-legend span{display:inline-flex; align-items:center; gap:5px;}

  /* WALLETS SCREEN */
  .wallets-grid{display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:16px;}
  .wcard{background:var(--panel); border:1px solid var(--border); border-radius:16px; padding:14px; cursor:pointer;}
  .wcard .wtop{display:flex; align-items:center; gap:8px; margin-bottom:14px;}
  .wcard .wname2{font-size:13px; color:var(--sub);}
  .wcard .wbal{font-size:17px; font-weight:700;}
  .add-wallet-card{border:1.5px dashed var(--border); background:transparent; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px; color:var(--sub); font-size:12px; min-height:84px;}
  .add-wallet-card .plus{font-size:22px; color:var(--blue);}

  /* PROFILE */
  .profile-head{text-align:center; padding-top:26px;}
  .profile-avatar{width:76px; height:76px; border-radius:50%; background:linear-gradient(135deg,#f472b6,#a855f7); margin:0 auto 12px; display:flex; align-items:center; justify-content:center; font-size:26px; font-weight:700;}
  .profile-head h2{font-size:18px;}
  .profile-head p{font-size:12.5px; color:var(--sub); margin-top:2px;}
  .menu-list{margin-top:22px; background:var(--panel); border:1px solid var(--border); border-radius:16px; overflow:hidden;}
  .menu-item{display:flex; align-items:center; gap:12px; padding:14px 16px; border-bottom:1px solid var(--border); cursor:pointer; font-size:13.5px;}
  .menu-item:last-child{border-bottom:none;}
  .menu-item .mic{width:22px; display:inline-flex; align-items:center; justify-content:center; flex-shrink:0;}
  .menu-item .marrow{margin-left:auto; color:var(--sub);}

  /* THEME PICKER */
  .theme-option{display:flex; align-items:center; gap:14px; padding:14px; border:1.5px solid var(--border); border-radius:14px; margin-bottom:10px; cursor:pointer; transition:border-color .15s, background .15s;}
  .theme-option.active{border-color:var(--blue); background:rgba(59,130,246,.1);}
  .theme-swatch{width:42px; height:42px; border-radius:50%; flex-shrink:0; border:1px solid rgba(255,255,255,.15); position:relative; overflow:hidden;}
  .theme-swatch .sw-panel{position:absolute; right:0; bottom:0; width:60%; height:60%; border-radius:50% 0 0 0;}
  .theme-option .tname{font-size:14px; font-weight:600;}
  .theme-option .tdesc{font-size:11.5px; color:var(--sub); margin-top:2px;}
  .theme-check{margin-left:auto; font-size:16px; color:var(--blue); visibility:hidden;}
  .theme-option.active .theme-check{visibility:visible;}

  /* MODAL */
  .overlay{position:absolute; inset:0; background:rgba(0,0,0,.6); z-index:60; display:none; align-items:flex-end; justify-content:center;}
  .overlay.open{display:flex;}
  .modal{width:100%; background:var(--panel); border-radius:24px 24px 0 0; padding:20px 20px 26px; max-height:80%; overflow-y:auto; border:1px solid var(--border); border-bottom:none;}
  .modal-head{display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;}
  .modal-head h3{font-size:16px;}
  .modal-close{width:30px; height:30px; border-radius:50%; background:var(--panel2); border:1px solid var(--border); display:flex; align-items:center; justify-content:center; cursor:pointer; font-size:14px;}

  /* TOAST */
  .toast{position:absolute; bottom:100px; left:50%; transform:translateX(-50%) translateY(20px); background:#1c2130; border:1px solid var(--border); padding:10px 18px; border-radius:30px; font-size:12.5px; opacity:0; pointer-events:none; transition:all .25s ease; z-index:80; white-space:nowrap;}
  .toast.show{opacity:1; transform:translateX(-50%) translateY(0);}

  /* BOTTOM NAV */
  .bottomnav{position:absolute; left:0; right:0; bottom:0; background:rgba(11,14,20,.95); backdrop-filter:blur(10px); border-top:1px solid var(--border); display:flex; padding:10px 10px 8px; z-index:30;}
