    ${t.desc ? `<div class="textbox" style="margin-bottom:16px;">${t.desc}</div>` : ''}
    <button class="btn-danger" onclick="deleteTx('${t.id}')">Delete Transaction</button>
  `);
}
function deleteTx(id){
  const t = state.transactions.find(x=>x.id===id);
  const w = walletById(t.wallet);
  if(w){
    if(txSign(t)==='-') w.balance += t.amount; else w.balance -= t.amount;
  }
  state.transactions = state.transactions.filter(x=>x.id!==id);
