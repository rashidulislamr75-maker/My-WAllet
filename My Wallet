function getFilteredTx(){
  const now = new Date();
  return state.transactions.filter(t=>{
    if(periodFilter==='month' && (t.dt.getMonth()!==now.getMonth() || t.dt.getFullYear()!==now.getFullYear())) return false;
    if(walletFilterIdx!==-1 && t.wallet!==state.wallets[walletFilterIdx].id) return false;
    return true;
  });
}
function renderAnalytics(){
  const filtered = getFilteredTx();
  const catFilter = document.getElementById('categoryFilter') ? document.getElementById('categoryFilter').value : 'all';

  const histList = [...filtered].sort((a,b)=>b.dt-a.dt);
  document.getElementById('historyList').innerHTML = histList.length ? histList.map(t=>{
    const w = walletById(t.wallet);
    return `<div class="tx-row">
      <div class="tx-icon">${txIcon(t)}</div>
      <div class="tx-info"><div class="tname">${t.note||t.type}</div><div class="tmeta">${dateLabel(t.dt)} • ${w?w.name:'—'}</div></div>
      <div class="tx-amt ${txClass(t)}">${txSign(t)}${fmt(t.amount)}</div>
      <div class="xdel" onclick="event.stopPropagation();deleteTx('${t.id}')"><svg class="ic" style="width:14px;height:14px;" viewBox="0 0 24 24"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg></div>
    </div>`;
  }).join('') : `<div class="empty-note">No transactions match this filter.</div>`;

  let expenses = filtered.filter(t=>t.type==='expense');
  if(catFilter!=='all') expenses = expenses.filter(t=>t.subcat===catFilter);
  const byCat = {};
  expenses.forEach(t=>{ byCat[t.subcat||'Other'] = (byCat[t.subcat||'Other']||0) + t.amount; });
  const total = Object.values(byCat).reduce((a,b)=>a+b,0);
  const colors = {"Food & Dining":"#3b82f6","Rent & Utilities":"#22c55e","Transportation":"#ef4444","Shopping":"#a855f7","Entertainment":"#f472b6","Other":"#94a3b8"};

  let svg = '';
  let offset = 0;
  Object.entries(byCat).forEach(([cat,amt])=>{
    const pct = total? (amt/total*100):0;
    svg += `<circle cx="21" cy="21" r="15.9" fill="transparent" stroke="${colors[cat]||'#94a3b8'}" stroke-width="6" stroke-dasharray="${pct} ${100-pct}" stroke-dashoffset="${25-offset}"></circle>`;
    offset += pct;
  });
  svg += `<text x="21" y="19" text-anchor="middle" font-size="4.2" fill="var(--text)" font-weight="700">TOTAL</text><text x="21" y="25" text-anchor="middle" font-size="4.2" fill="var(--text)" font-weight="700">${Math.round(total).toLocaleString()}</text>`;
  document.getElementById('donutSvg').innerHTML = total ? svg : `<circle cx="21" cy="21" r="15.9" fill="transparent" stroke="var(--border)" stroke-width="6"></circle><text x="21" y="23" text-anchor="middle" font-size="4" fill="var(--sub)">No data</text>`;

  document.getElementById('donutLegend').innerHTML = Object.entries(byCat).map(([cat,amt])=>{
    const pct = total? Math.round(amt/total*100):0;
    return `<div class="legend-item"><span class="dot" style="background:${colors[cat]||'#94a3b8'}"></span>${cat} (${pct}%)</div>`;
  }).join('') || '<div class="legend-item">Add an expense to see the breakdown</div>';

  document.getElementById('catList').innerHTML = Object.entries(byCat).sort((a,b)=>b[1]-a[1]).map(([cat,amt])=>`
    <div class="cat-row"><span class="dot" style="background:${colors[cat]||'#94a3b8'}"></span><div class="cname">${cat}</div><div class="camt">${fmt(amt)}</div></div>
  `).join('') || '';

  let barsSrc = state.transactions;
  if(walletFilterIdx!==-1) barsSrc = barsSrc.filter(t=>t.wallet===state.wallets[walletFilterIdx].id);
  const months = [];
  const now = new Date();
  for(let i=5;i>=0;i--){ const d=new Date(now.getFullYear(), now.getMonth()-i, 1); months.push(d); }
  let maxVal = 1;
  const monthData = months.map(m=>{
    const inSum = barsSrc.filter(t=>t.type==='income' && t.dt.getMonth()===m.getMonth() && t.dt.getFullYear()===m.getFullYear()).reduce((a,b)=>a+b.amount,0);
    const exSum = barsSrc.filter(t=>t.type==='expense' && t.dt.getMonth()===m.getMonth() && t.dt.getFullYear()===m.getFullYear()).reduce((a,b)=>a+b.amount,0);
    maxVal = Math.max(maxVal, inSum, exSum);
    return {label:m.toLocaleDateString('en-US',{month:'short'}).toUpperCase(), inSum, exSum};
  });
  document.getElementById('barsChart').innerHTML = monthData.map(md=>`
    <div class="bar-group">
      <div class="bar-pair">
        <div class="bar in" style="height:${Math.max(4,md.inSum/maxVal*70)}px"></div>
        <div class="bar ex" style="height:${Math.max(4,md.exSum/maxVal*70)}px"></div>
      </div>
      <div class="m">${md.label}</div>
    </div>`).join('');
}

