  const w = walletById(id);
  openModal(`
    <div class="modal-head"><h3>Adjust Balance — ${w.name}</h3><div class="modal-close" onclick="closeModal()"><svg class="ic" style="width:14px;height:14px;" viewBox="0 0 24 24"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg></div></div>
