// FIX: Home page is the one screen whose content (the horizontally-scrollable
// wallet row) is briefly wider than the viewport while being injected/measured.
// AppsGeyser-style Android WebViews using useWideViewPort(true) sometimes
// mis-measure that moment and lock the whole page's zoom/scale to it,
// cropping the sides — even though CSS `contain` on .wallets-scroll now
// stops it from actually happening in most cases. This function is kept as
// a belt-and-braces nudge: it forces the WebView to recompute the correct
// scale, and now runs several times (immediately + staggered delays) since
// some WebViews re-measure asynchronously, later than a single rAF catches.
function fixHomeZoom(){
  const meta = document.querySelector('meta[name="viewport"]');
  if(!meta) return;
  const original = meta.getAttribute('content');
  const w = document.documentElement.clientWidth || window.innerWidth;
  const nudge = ()=>{
    meta.setAttribute('content', 'width='+w+', initial-scale=1, maximum-scale=1, user-scalable=no');
    requestAnimationFrame(()=>{
      meta.setAttribute('content', original);
      window.scrollTo(0,0);
    });
  };
  [0, 50, 150, 300, 600, 1000].forEach(t=>setTimeout(nudge, t));
}
function computeSums(list){
  const s = {income:0, expense:0, savings:0, loanGiven:0, loanTaken:0};
  list.forEach(t=>{ s[t.type] = (s[t.type]||0) + t.amount; });
  return s;
}
