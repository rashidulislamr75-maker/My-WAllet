function txSign(t){
  if(t.type==='adjustment') return t.sign;
  return (t.type==='expense' || t.type==='savings' || t.type==='loanGiven') ? '-' : '+';
}
function txClass(t){ return txSign(t)==='-' ? 'neg' : 'pos'; }
function dateLabel(dt){
  const now=new Date(); const d0=new Date(now.getFullYear(),now.getMonth(),now.getDate());
  const d1=new Date(dt.getFullYear(),dt.getMonth(),dt.getDate());
  const diff = Math.round((d0-d1)/86400000);
  if(diff===0) return 'Today, '+dt.toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'});
  if(diff===1) return 'Yesterday, '+dt.toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'});
  return dt.toLocaleDateString('en-US',{day:'2-digit',month:'short'});
}
function txRowHtml(t){
  const w = walletById(t.wallet);
  return `<div class="tx-row" onclick="openTxModal('${t.id}')">
    <div class="tx-icon">${txIcon(t)}</div>
    <div class="tx-info"><div class="tname">${t.note || t.type}</div><div class="tmeta">${dateLabel(t.dt)} • ${w?w.name:'—'}</div></div>
    <div class="tx-amt ${txClass(t)}">${txSign(t)}${fmt(t.amount)}</div>
  </div>`;
}

